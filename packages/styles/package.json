{
  "name": "@dx/styles",
  "version": "0.2.0",
  "description": "DX Design System styles — Tailwind v4 theme + semantic tokens",
  "type": "module",
  "main": "dist/styles.css",
  "exports": {
    ".": "./dist/styles.css",
    "./tokens": "./src/tokens.css",
    "./theme": "./src/themes/default.css"
  },
  "files": ["dist", "src"],
  "scripts": {
    "build": "postcss src/themes/default.css -o dist/styles.css",
    "dev": "postcss src/themes/default.css -o dist/styles.css --watch"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "postcss": "^8",
    "postcss-cli": "^11",
    "tailwindcss": "^4"
  }
}
